    {
      "id": "text_9o",
      "type": "text",
      "x": 52,
      "y": 862,
      "width": 696,
      "height": 151,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 315214013,
      "version": 1,
      "versionNonce": 773982528,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "subject: org_unit=ide-users, environment=prod\nmode_default: balanced          # cost | balanced | quality | residency_strict\nsplit:  aap-balanced 70%  ·  aap-deep 20%  ·  aap-internal-secure 10%\nhard_constraints:\n   residency: eu_zone_or_stricter\n   max_data_class: internal\n   monthly_budget_usd: 12000   # then degrade to aap-fast, then block\noverrides: member may request a specific alias if it satisfies the constraints",
      "originalText": "subject: org_unit=ide-users, environment=prod\nmode_default: balanced          # cost | balanced | quality | residency_strict\nsplit:  aap-balanced 70%  ·  aap-deep 20%  ·  aap-internal-secure 10%\nhard_constraints:\n   residency: eu_zone_or_stricter\n   max_data_class: internal\n   monthly_budget_usd: 12000   # then degrade to aap-fast, then block\noverrides: member may request a specific alias if it satisfies the constraints",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
