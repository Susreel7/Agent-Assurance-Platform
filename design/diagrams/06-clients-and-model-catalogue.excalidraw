      "versionNonce": 1438642685,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Route:  ~/.codex/config.toml\n[model_providers.aap] base_url, env_key,\nwire_api = \"responses\".\nSo our gateway must implement the Responses\nAPI, not only chat completions.\nOrg control: provider keys are user-level;\nproject configs cannot override them, which\nis useful — a repo cannot redirect traffic.",
      "originalText": "Route:  ~/.codex/config.toml\n[model_providers.aap] base_url, env_key,\nwire_api = \"responses\".\nSo our gateway must implement the Responses\nAPI, not only chat completions.\nOrg control: provider keys are user-level;\nproject configs cannot override them, which\nis useful — a repo cannot redirect traffic.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
