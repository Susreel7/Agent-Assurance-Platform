      "versionNonce": 1411178961,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Route:  GOOGLE_GEMINI_BASE_URL, or\nGOOGLE_VERTEX_BASE_URL for Vertex auth.\nHonoured through the genai SDK http options;\nHTTPS required off localhost, and the\nbehaviour has moved between releases — pin\na version in the rollout guide.\nOrg control: thin. Treat the gateway plus MDM\nas the only real enforcement.",
      "originalText": "Route:  GOOGLE_GEMINI_BASE_URL, or\nGOOGLE_VERTEX_BASE_URL for Vertex auth.\nHonoured through the genai SDK http options;\nHTTPS required off localhost, and the\nbehaviour has moved between releases — pin\na version in the rollout guide.\nOrg control: thin. Treat the gateway plus MDM\nas the only real enforcement.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
