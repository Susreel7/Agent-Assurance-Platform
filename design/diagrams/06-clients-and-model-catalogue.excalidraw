      "versionNonce": 1335202490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Route:  ANTHROPIC_BASE_URL + auth token,\nor the Bedrock/Vertex/Foundry base URLs.\nOrg control: managed settings deliver\navailableModels (checked at the gateway too),\npermissions allow/ask/deny,\nallowManagedPermissionRulesOnly,\nallowedMcpServers + allowManagedMcpServersOnly,\ndisableBypassPermissionsMode.\nCaveat: a delivered base URL can prompt the\nuser.",
      "originalText": "Route:  ANTHROPIC_BASE_URL + auth token,\nor the Bedrock/Vertex/Foundry base URLs.\nOrg control: managed settings deliver\navailableModels (checked at the gateway too),\npermissions allow/ask/deny,\nallowManagedPermissionRulesOnly,\nallowedMcpServers + allowManagedMcpServersOnly,\ndisableBypassPermissionsMode.\nCaveat: a delivered base URL can prompt the\nuser.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
