      "seed": 484125930,
      "version": 1,
      "versionNonce": 325720376,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What the model gateway and the MCP gateway saw",
      "originalText": "What the model gateway and the MCP gateway saw",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_hn",
      "type": "text",
      "x": 52,
      "y": 422,
      "width": 1376,
      "height": 57,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1120490209,
      "version": 1,
      "versionNonce": 659745297,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Nothing. A model gateway sits on the path of a model request, and this was not one. An MCP gateway sits on the path of a\ntools/call, and this was not one either. The destructive action travelled Bash → curl → public HTTPS API. Both of the\nenforcement points in the earlier design were off the path, and the only audit trail was the agent's own later confession.",
      "originalText": "Nothing. A model gateway sits on the path of a model request, and this was not one. An MCP gateway sits on the path of a\ntools/call, and this was not one either. The destructive action travelled Bash → curl → public HTTPS API. Both of the\nenforcement points in the earlier design were off the path, and the only audit trail was the agent's own later confession.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_ho",
      "type": "rectangle",
      "x": 40,
      "y": 520,
      "width": 453,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1530230124,
      "version": 1,
      "versionNonce": 890793392,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_hp",
      "type": "text",
      "x": 52,
      "y": 532,
      "width": 146,
      "height": 22,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
