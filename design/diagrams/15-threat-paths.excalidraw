      "frameId": null,
      "roundness": null,
      "seed": 422761351,
      "version": 1,
      "versionNonce": 1723560327,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A · the credential",
      "originalText": "A · the credential",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_hq",
      "type": "text",
      "x": 52,
      "y": 560,
      "width": 429,
      "height": 114,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 169092543,
      "version": 1,
      "versionNonce": 1828284553,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A per-task lease could not have carried\nvolumeDelete against a production project.\nThe real token was long-lived,\naccount-scoped and readable from the\nagent's own workspace. This is the control\nthat would have stopped it outright.",
      "originalText": "A per-task lease could not have carried\nvolumeDelete against a production project.\nThe real token was long-lived,\naccount-scoped and readable from the\nagent's own workspace. This is the control\nthat would have stopped it outright.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_hr",
      "type": "rectangle",
      "x": 513,
      "y": 520,
      "width": 453,
      "height": 175,
      "angle": 0,
