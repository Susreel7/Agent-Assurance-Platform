      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "D · the ledger",
      "originalText": "D · the ledger",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_hw",
      "type": "text",
      "x": 998,
      "y": 560,
      "width": 429,
      "height": 114,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 108176975,
      "version": 1,
      "versionNonce": 1278014368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "fs.read of a credential-shaped file, then\nnet.http to a provider control plane, inside\nnine seconds, from one session. That is a\ndetection, an alert and a revocation.\nIt is not a prevention, and we will not\ndescribe it as one.",
      "originalText": "fs.read of a credential-shaped file, then\nnet.http to a provider control plane, inside\nnine seconds, from one session. That is a\ndetection, an alert and a revocation.\nIt is not a prevention, and we will not\ndescribe it as one.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
