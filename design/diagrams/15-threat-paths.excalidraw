      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 135700751,
      "version": 1,
      "versionNonce": 585828171,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_hs",
      "type": "text",
      "x": 525,
      "y": 532,
      "width": 98,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 446978645,
      "version": 1,
      "versionNonce": 337971386,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "B · the hook",
      "originalText": "B · the hook",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_ht",
      "type": "text",
      "x": 525,
      "y": 560,
      "width": 429,
      "height": 114,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1930990994,
      "version": 1,
      "versionNonce": 1486056986,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A PreToolUse veto on shell.exec matching a\ndestructive verb against a production\naudience, on hardware the customer\nadministers. Real prevention, and honestly\nbypassable by running a different client —\nwhich is exactly why it is graded B.",
      "originalText": "A PreToolUse veto on shell.exec matching a\ndestructive verb against a production\naudience, on hardware the customer\nadministers. Real prevention, and honestly\nbypassable by running a different client —\nwhich is exactly why it is graded B.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_hu",
