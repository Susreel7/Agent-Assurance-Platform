      "versionNonce": 1747138018,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "token → ciphertext, AEAD under the\ncustomer KMS key, per-account key ring\nStable within a session so the model can\nreason about 'the same person'\nTTL measured in hours, then unrecoverable\nDetokenize on the response path, inside\nthe boundary, before the client sees it\nThe control plane never receives the map",
      "originalText": "token → ciphertext, AEAD under the\ncustomer KMS key, per-account key ring\nStable within a session so the model can\nreason about 'the same person'\nTTL measured in hours, then unrecoverable\nDetokenize on the response path, inside\nthe boundary, before the client sees it\nThe control plane never receives the map",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
