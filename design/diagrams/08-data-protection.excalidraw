      "x": 752,
      "y": 192,
      "width": 376,
      "height": 208,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 959124630,
      "version": 1,
      "versionNonce": 305069057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "allow              nothing found, or class permitted\nannotate           record only, useful while tuning\nmask irreversible ****, model loses the value\ntokenize PERSON_1 / ACCT_7, reversible in boundary\nroute_internal     send to a self-hosted model instead\nrequire_approval human releases it, with justification\nblock refuse, name the policy and an alternative\n\nsecret_material is block or mask. Never tokenize a\ncredential: a reversible credential is still a\ncredential.",
      "originalText": "allow              nothing found, or class permitted\nannotate           record only, useful while tuning\nmask irreversible ****, model loses the value\ntokenize PERSON_1 / ACCT_7, reversible in boundary\nroute_internal     send to a self-hosted model instead\nrequire_approval human releases it, with justification\nblock refuse, name the policy and an alternative\n\nsecret_material is block or mask. Never tokenize a\ncredential: a reversible credential is still a\ncredential.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
