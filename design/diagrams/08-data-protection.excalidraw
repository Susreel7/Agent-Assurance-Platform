      "roundness": null,
      "seed": 197382996,
      "version": 1,
      "versionNonce": 1637141824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Detection reduces risk; it does not prove absence. Names, addresses and\nparaphrased secrets are missed by every detector, ours included.\nSo the most sensitive classes must be policy-protected by destination\n(route to an internal model) rather than by redaction confidence.\nEvery rule ships with a measured false-positive rate on the customer's own\ntraffic in annotate mode before it is allowed to block.",
      "originalText": "Detection reduces risk; it does not prove absence. Names, addresses and\nparaphrased secrets are missed by every detector, ours included.\nSo the most sensitive classes must be policy-protected by destination\n(route to an internal model) rather than by redaction confidence.\nEvery rule ships with a measured false-positive rate on the customer's own\ntraffic in annotate mode before it is allowed to block.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
