      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Finding → data class:\n  secret_material\n  customer_pii · employee_pii\n  health · financial\n  source_code · internal_doc\n  regulated_record\nHighest class wins for the request.\nConfidence is kept, and low-confidence\nfindings can be set to annotate rather\nthan block so the tool stays usable.",
      "originalText": "Finding → data class:\n  secret_material\n  customer_pii · employee_pii\n  health · financial\n  source_code · internal_doc\n  regulated_record\nHighest class wins for the request.\nConfidence is kept, and low-confidence\nfindings can be set to annotate rather\nthan block so the tool stays usable.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
