    {
      "id": "text_47",
      "type": "text",
      "x": 52,
      "y": 1149,
      "width": 1436,
      "height": 76,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 942977095,
      "version": 1,
      "versionNonce": 383970933,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A DL admin on ide-users holds role dl_admin scoped to that org unit with subtree=true. They see those members' usage,\ncost, tool calls and denials, and can drill into any one of them; they see aggregate counts for the rest of the company\nand nothing identifiable. A VP above them sees both DLs and the union. A member sees only themselves. Security admins\nsee every denial and incident company-wide but need a separate payload:reveal grant plus an approval to read any prompt.",
      "originalText": "A DL admin on ide-users holds role dl_admin scoped to that org unit with subtree=true. They see those members' usage,\ncost, tool calls and denials, and can drill into any one of them; they see aggregate counts for the rest of the company\nand nothing identifiable. A VP above them sees both DLs and the union. A member sees only themselves. Security admins\nsee every denial and incident company-wide but need a separate payload:reveal grant plus an approval to read any prompt.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
  ],
