      "roundness": null,
      "seed": 357384150,
      "version": 1,
      "versionNonce": 554168299,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A coverage figure without a denominator does not ship. \"1,284 actions governed\" is not a number; \"1,284 of an estimated 1,610,\nof which 402 are grade D observation only and 180 are grade E we cannot see\" is a number. The grade is a mandatory column on\nevery decision row, and a row whose grade is unknown is counted as E. This is the single habit that survives first contact with a\nCISO who has already been sold a control that turned out to be a dashboard.",
      "originalText": "A coverage figure without a denominator does not ship. \"1,284 actions governed\" is not a number; \"1,284 of an estimated 1,610,\nof which 402 are grade D observation only and 180 are grade E we cannot see\" is a number. The grade is a mandatory column on\nevery decision row, and a row whose grade is unknown is counted as E. This is the single habit that survives first contact with a\nCISO who has already been sold a control that turned out to be a dashboard.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
