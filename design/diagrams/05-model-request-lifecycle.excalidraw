      "frameId": null,
      "roundness": null,
      "seed": 1695582949,
      "version": 1,
      "versionNonce": 440293068,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A high-risk request returns 409 with an approval id and a resume token.\nApprover is notified in the console and over Slack/Teams/email webhook.\nOn approval the client retries with the token; the gateway re-checks policy\n(state can have changed) and then dispatches. Tokens are single use and expire.",
      "originalText": "A high-risk request returns 409 with an approval id and a resume token.\nApprover is notified in the console and over Slack/Teams/email webhook.\nOn approval the client retries with the token; the gateway re-checks policy\n(state can have changed) and then dispatches. Tokens are single use and expire.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
