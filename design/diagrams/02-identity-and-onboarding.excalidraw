      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Exactly one path per deployment:\nSaaS — signed provisioning token from onboarding\nVPC / on-prem — installer-sealed bootstrap credential\nAir-gap — offline licence + sealed credential\nFirst holder gets account_owner, single use,\nconsumed and audited. No implicit owner from login.",
      "originalText": "Exactly one path per deployment:\nSaaS — signed provisioning token from onboarding\nVPC / on-prem — installer-sealed bootstrap credential\nAir-gap — offline licence + sealed credential\nFirst holder gets account_owner, single use,\nconsumed and audited. No implicit owner from login.",
      "fontSize": 13,
      "fontFamily": 2,
