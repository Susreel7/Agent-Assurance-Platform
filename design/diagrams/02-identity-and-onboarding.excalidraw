      "version": 1,
      "versionNonce": 1084744469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "401 expired      silent renew, then re-auth\n401 unknown      \"not provisioned\" + request access\n403 module        empty state naming the role needed\n403 scope        \"outside your visibility\" + owner\n409 pending      \"awaiting approval\", with request id\n5xx / offline     retry with the reason code visible",
      "originalText": "401 expired      silent renew, then re-auth\n401 unknown      \"not provisioned\" + request access\n403 module        empty state naming the role needed\n403 scope        \"outside your visibility\" + owner\n409 pending      \"awaiting approval\", with request id\n5xx / offline     retry with the reason code visible",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
