      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rediscovery compares digests.\nNew or changed tool → stays invisible,\nraises a review item.\nRemoved tool → grant flagged, not deleted.\nDefinition changed under an approved name\n→ server moves to in_review automatically.",
      "originalText": "Rediscovery compares digests.\nNew or changed tool → stays invisible,\nraises a review item.\nRemoved tool → grant flagged, not deleted.\nDefinition changed under an approved name\n→ server moves to in_review automatically.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
