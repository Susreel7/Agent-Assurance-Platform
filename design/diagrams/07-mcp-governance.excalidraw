      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why enforcement cannot live in the client",
      "originalText": "Why enforcement cannot live in the client",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_aq",
      "type": "text",
      "x": 52,
      "y": 979,
      "width": 1436,
      "height": 76,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1951380919,
      "version": 1,
      "versionNonce": 33132688,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cursor's MCP allowlist, Claude Code's permission rules and MDM-delivered files are all useful defence in depth, and we should\ngenerate them. None of them is a control we can attest to: they run on a machine the user administers, and the model itself\nchooses which tool to invoke with which arguments. The only place a customer can be told 'this cannot happen' is the gateway\nthat owns the URL and holds the upstream credential. That is why the upstream credential must never reach the client.",
      "originalText": "Cursor's MCP allowlist, Claude Code's permission rules and MDM-delivered files are all useful defence in depth, and we should\ngenerate them. None of them is a control we can attest to: they run on a machine the user administers, and the model itself\nchooses which tool to invoke with which arguments. The only place a customer can be told 'this cannot happen' is the gateway\nthat owns the URL and holds the upstream credential. That is why the upstream credential must never reach the client.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
