      "versionNonce": 857868389,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Quarantine takes effect within one cache TTL\n(≤ 5 s) for every caller and environment.\nReason and actor are recorded; release is a\nseparate permission from quarantine.\nPer-subject revoke is instant and audited.",
      "originalText": "Quarantine takes effect within one cache TTL\n(≤ 5 s) for every caller and environment.\nReason and actor are recorded; release is a\nseparate permission from quarantine.\nPer-subject revoke is instant and audited.",
