      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Algorithms, and why each one",
      "originalText": "Algorithms, and why each one",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_c7",
      "type": "text",
      "x": 812,
      "y": 472,
      "width": 676,
      "height": 132,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 972263397,
      "version": 1,
      "versionNonce": 1018815049,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "t-digest        p50/p95/p99 latency mergeable across buckets\nHyperLogLog     unique active people per org unit without a distinct scan\ncount-min       top-K tools and models under a fixed memory budget\nEWMA + MAD      per-subject baselines for anomaly alerts, robust to outliers\nclosure table   hierarchy reads in one indexed join\ntoken bucket    per-subject rate limits in Redis, one round trip\nBloom filter    de-duplicate secret fingerprints without storing secrets",
      "originalText": "t-digest        p50/p95/p99 latency mergeable across buckets\nHyperLogLog     unique active people per org unit without a distinct scan\ncount-min       top-K tools and models under a fixed memory budget\nEWMA + MAD      per-subject baselines for anomaly alerts, robust to outliers\nclosure table   hierarchy reads in one indexed join\ntoken bucket    per-subject rate limits in Redis, one round trip\nBloom filter    de-duplicate secret fingerprints without storing secrets",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_c8",
