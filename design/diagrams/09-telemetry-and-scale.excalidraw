      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 505850856,
      "version": 1,
      "versionNonce": 1037603586,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every console query hits a rollup keyed by (account, bucket, org_path, member,\nagent, alias, server, tool, decision). A manager view is a path prefix scan.\nRaw events are reachable only from a drill-down that already names a narrow\nwindow and one subject, and that read is itself audited.\nAggregate endpoints are cursor-paginated and return totals from sketches, never\nfrom count(*) over a partition.",
      "originalText": "Every console query hits a rollup keyed by (account, bucket, org_path, member,\nagent, alias, server, tool, decision). A manager view is a path prefix scan.\nRaw events are reachable only from a drill-down that already names a narrow\nwindow and one subject, and that read is itself audited.\nAggregate endpoints are cursor-paginated and return totals from sketches, never\nfrom count(*) over a partition.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
