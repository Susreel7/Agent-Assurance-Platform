      "seed": 1813619764,
      "version": 1,
      "versionNonce": 921274442,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "~25M events/day at ~350 bytes compressed ≈ 9 GB/day raw, ~1 GB/day after rollup, well inside a three-node ClickHouse cluster.\nGateway cost is dominated by inspection, not policy: budget 4–8 ms for DLP on a 32 KB prompt and cache compiled rules per policy\nversion. Policy evaluation is a hash lookup plus a bounded rule walk, sub-millisecond, and must stay that way — no database call\non the request path, only the local cache with a 5 second TTL and an explicit invalidation channel.",
      "originalText": "~25M events/day at ~350 bytes compressed ≈ 9 GB/day raw, ~1 GB/day after rollup, well inside a three-node ClickHouse cluster.\nGateway cost is dominated by inspection, not policy: budget 4–8 ms for DLP on a 32 KB prompt and cache compiled rules per policy\nversion. Policy evaluation is a hash lookup plus a bounded rule walk, sub-millisecond, and must stay that way — no database call\non the request path, only the local cache with a 5 second TTL and an explicit invalidation channel.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
  ],
