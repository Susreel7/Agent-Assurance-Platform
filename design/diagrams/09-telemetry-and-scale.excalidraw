      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cardinality discipline (the thing that actually kills these systems)",
      "originalText": "Cardinality discipline (the thing that actually kills these systems)",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_ca",
      "type": "text",
      "x": 52,
      "y": 702,
      "width": 696,
      "height": 76,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2001303764,
      "version": 1,
      "versionNonce": 382131749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dimensions are enumerable or bucketed. member, agent, alias, server, tool, decision,\nreason_code: enumerable. Anything free-form — prompt text, request id, argument values —\nis never a rollup dimension. Beyond top-N per bucket, the tail folds into 'other' and the\nexact answer stays available in raw events for the retention window.",
      "originalText": "Dimensions are enumerable or bucketed. member, agent, alias, server, tool, decision,\nreason_code: enumerable. Anything free-form — prompt text, request id, argument values —\nis never a rollup dimension. Beyond top-N per bucket, the tail folds into 'other' and the\nexact answer stays available in raw events for the retention window.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
