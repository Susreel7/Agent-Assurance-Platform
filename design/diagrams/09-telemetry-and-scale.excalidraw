      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cost and token accounting",
      "originalText": "Cost and token accounting",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_cd",
      "type": "text",
      "x": 812,
      "y": 702,
      "width": 676,
      "height": 114,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 747634274,
      "version": 1,
      "versionNonce": 591352419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tokens come from the provider response; when a provider omits them we record\nmeasured=false and estimate, and the UI says which.\ncost_micros = tokens × effective price from an effective-dated price book, computed\nat ingest and stored, so a later price change cannot silently rewrite history.\nA correction job recomputes a window and writes a new version with a reason.\nBudgets decrement in Redis for enforcement and reconcile against ClickHouse hourly.",
      "originalText": "Tokens come from the provider response; when a provider omits them we record\nmeasured=false and estimate, and the UI says which.\ncost_micros = tokens × effective price from an effective-dated price book, computed\nat ingest and stored, so a later price change cannot silently rewrite history.\nA correction job recomputes a window and writes a new version with a reason.\nBudgets decrement in Redis for enforcement and reconcile against ClickHouse hourly.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
