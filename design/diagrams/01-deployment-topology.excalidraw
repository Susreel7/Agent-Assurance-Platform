      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Invariant — the control plane is not on the request path",
      "originalText": "Invariant — the control plane is not on the request path",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_1r",
      "type": "text",
      "x": 52,
      "y": 1199,
      "width": 706,
      "height": 57,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1784401605,
      "version": 1,
      "versionNonce": 1428277432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A control-plane outage must not open access. The data plane runs the last signed\npolicy bundle, keeps enforcing, and buffers telemetry. Bundles carry an expiry;\npast expiry the data plane fails closed for regulated classes and read-only for the rest.",
      "originalText": "A control-plane outage must not open access. The data plane runs the last signed\npolicy bundle, keeps enforcing, and buffers telemetry. Bundles carry an expiry;\npast expiry the data plane fails closed for regulated classes and read-only for the rest.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
