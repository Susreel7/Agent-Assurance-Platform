      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Invariant — payload separation",
      "originalText": "Invariant — payload separation",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_1u",
      "type": "text",
      "x": 822,
      "y": 1199,
      "width": 706,
      "height": 57,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 641703964,
      "version": 1,
      "versionNonce": 387921916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Prompt bodies, completions and tool arguments are written only to the customer-side\npayload store, referenced by digest. The control plane stores counts, digests, decisions\nand reason codes. Revealing a payload is a separate permission plus an audited approval.",
      "originalText": "Prompt bodies, completions and tool arguments are written only to the customer-side\npayload store, referenced by digest. The control plane stores counts, digests, decisions\nand reason codes. Revealing a payload is a separate permission plus an audited approval.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
