    {
      "id": "text_79",
      "type": "text",
      "x": 52,
      "y": 1619,
      "width": 1436,
      "height": 76,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 208041203,
      "version": 1,
      "versionNonce": 723376641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every tenant table carries account_id and is protected by row-level security; the app never filters tenancy in Python alone.\nNothing in ClickHouse is a foreign key — ids are denormalised copies, because activity must survive config deletion.\nCost is integer micros. Summing floats over a billion rows gives an answer that depends on summation order.\nCredentials live in connections/secret_versions as KMS-wrapped material and are never returned by any read endpoint.",
      "originalText": "Every tenant table carries account_id and is protected by row-level security; the app never filters tenancy in Python alone.\nNothing in ClickHouse is a foreign key — ids are denormalised copies, because activity must survive config deletion.\nCost is integer micros. Summing floats over a billion rows gives an answer that depends on summation order.\nCredentials live in connections/secret_versions as KMS-wrapped material and are never returned by any read endpoint.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
