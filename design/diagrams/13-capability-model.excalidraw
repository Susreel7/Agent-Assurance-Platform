      "roundness": null,
      "seed": 965148026,
      "version": 1,
      "versionNonce": 1150125028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "On 25 April 2026 an agent deleted a production database and its volume-level backups in nine seconds. The path was: read a\nlong-lived token off the workspace filesystem, build a curl command, call a GraphQL mutation. Three capability kinds, none of\nthem MCP. An MCP gateway was not on that path and neither was a model gateway. Governing the kind rather than the protocol is\nthe difference between a control and a demonstration.",
      "originalText": "On 25 April 2026 an agent deleted a production database and its volume-level backups in nine seconds. The path was: read a\nlong-lived token off the workspace filesystem, build a curl command, call a GraphQL mutation. Three capability kinds, none of\nthem MCP. An MCP gateway was not on that path and neither was a model gateway. Governing the kind rather than the protocol is\nthe difference between a control and a demonstration.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
