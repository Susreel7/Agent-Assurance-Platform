      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gd",
      "type": "text",
      "x": 442,
      "y": 192,
      "width": 466,
      "height": 132,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1878062327,
      "version": 1,
      "versionNonce": 2071912159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every action resolves to exactly one human at the root.\n`root_human_basis` records why that human is there:\ninteractive · scheduled_by · approved_by · owner_of_record.\nA job that fires at 03:00 is attributed to its owner, and the\nevidence says owner_of_record rather than implying that\nsomebody was at a keyboard. A service identity may never\nbe the root of a chain.",
      "originalText": "Every action resolves to exactly one human at the root.\n`root_human_basis` records why that human is there:\ninteractive · scheduled_by · approved_by · owner_of_record.\nA job that fires at 03:00 is attributed to its owner, and the\nevidence says owner_of_record rather than implying that\nsomebody was at a keyboard. A service identity may never\nbe the root of a chain.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_ge",
      "type": "rectangle",
      "x": 430,
      "y": 370,
      "width": 490,
      "height": 160,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 663419005,
      "version": 1,
      "versionNonce": 622646291,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_gf",
      "type": "text",
      "x": 442,
      "y": 382,
      "width": 282,
      "height": 24,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1725473096,
      "version": 1,
      "versionNonce": 158568121,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What gets approved is the version",
      "originalText": "What gets approved is the version",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gg",
      "type": "text",
      "x": 442,
      "y": 412,
      "width": 466,
      "height": 95,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 610050883,
      "version": 1,
      "versionNonce": 1470405629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "An agent is a name. An agent version is a composition\ndigest: system prompt, tool set, MCP snapshot, model,\nmemory scopes. Approval binds to the digest.\nA changed digest is a new version, and it is unapproved\nuntil a human approves it.",
      "originalText": "An agent is a name. An agent version is a composition\ndigest: system prompt, tool set, MCP snapshot, model,\nmemory scopes. Approval binds to the digest.\nA changed digest is a new version, and it is unapproved\nuntil a human approves it.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_gh",
      "type": "rectangle",
      "x": 430,
      "y": 560,
      "width": 490,
      "height": 170,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "#e3fafc",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1468100462,
      "version": 1,
      "versionNonce": 1864533849,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_gi",
      "type": "text",
      "x": 442,
      "y": 572,
      "width": 265,
      "height": 24,
      "angle": 0,
      "strokeColor": "#0b7285",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1873779309,
      "version": 1,
      "versionNonce": 1484780393,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The instance is what you revoke",
      "originalText": "The instance is what you revoke",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gj",
      "type": "text",
      "x": 442,
      "y": 602,
      "width": 466,
      "height": 95,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1715115525,
      "version": 1,
      "versionNonce": 551948131,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One running copy: this laptop, this CI job, this container.\nIt registers before it may act, and it carries the grade of\nenforcement actually available to it — which is how a report\ncan say \"B here, D there\" instead of one average that is true\nnowhere. Revocation targets an instance, a session or a lease.",
      "originalText": "One running copy: this laptop, this CI job, this container.\nIt registers before it may act, and it carries the grade of\nenforcement actually available to it — which is how a report\ncan say \"B here, D there\" instead of one average that is true\nnowhere. Revocation targets an instance, a session or a lease.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_gk",
      "type": "rectangle",
      "x": 950,
      "y": 150,
      "width": 490,
      "height": 190,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1406106819,
      "version": 1,
      "versionNonce": 814112867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_gl",
      "type": "text",
      "x": 962,
      "y": 162,
      "width": 291,
      "height": 24,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1238946504,
      "version": 1,
      "versionNonce": 2062092928,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The credential is the real control",
      "originalText": "The credential is the real control",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gm",
      "type": "text",
      "x": 962,
      "y": 192,
      "width": 466,
      "height": 132,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1273205391,
      "version": 1,
      "versionNonce": 62935468,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The broker issues, per task: short-lived, audience-bound\n(RFC 8707), sender-constrained (RFC 9449 / RFC 8705),\nscoped to the least authority the task declared it needs.\nThis is the one control that survives a bypassed path.\nA stolen lease is narrow, expiring and attributable.\nIt is also the direct answer to the reference incident,\nwhose root cause was a long-lived token found on disk.",
      "originalText": "The broker issues, per task: short-lived, audience-bound\n(RFC 8707), sender-constrained (RFC 9449 / RFC 8705),\nscoped to the least authority the task declared it needs.\nThis is the one control that survives a bypassed path.\nA stolen lease is narrow, expiring and attributable.\nIt is also the direct answer to the reference incident,\nwhose root cause was a long-lived token found on disk.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_gn",
      "type": "rectangle",
      "x": 950,
      "y": 370,
      "width": 490,
      "height": 160,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1416098970,
      "version": 1,
      "versionNonce": 2108896860,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_go",
      "type": "text",
      "x": 962,
      "y": 382,
      "width": 257,
      "height": 24,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1393010319,
      "version": 1,
      "versionNonce": 2140637232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Taint travels with the session",
      "originalText": "Taint travels with the session",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gp",
      "type": "text",
      "x": 962,
      "y": 412,
      "width": 466,
      "height": 95,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 229183173,
      "version": 1,
      "versionNonce": 1212678186,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A session that has ingested untrusted content is tainted.\nTaint does not block. It reduces what the session may do:\ngrants carry max_taint, and a tainted session loses the\ncapabilities whose ceiling it has passed — usually the\ndestructive ones and the ones that reach the internet.",
      "originalText": "A session that has ingested untrusted content is tainted.\nTaint does not block. It reduces what the session may do:\ngrants carry max_taint, and a tainted session loses the\ncapabilities whose ceiling it has passed — usually the\ndestructive ones and the ones that reach the internet.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_gq",
      "type": "rectangle",
      "x": 950,
      "y": 560,
      "width": 490,
      "height": 170,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1079466480,
      "version": 1,
      "versionNonce": 383245272,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_gr",
      "type": "text",
      "x": 962,
      "y": 572,
      "width": 257,
      "height": 24,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1208389454,
      "version": 1,
      "versionNonce": 216514220,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What this model does not claim",
      "originalText": "What this model does not claim",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gs",
      "type": "text",
      "x": 962,
      "y": 602,
      "width": 466,
      "height": 114,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1702487318,
      "version": 1,
      "versionNonce": 861123782,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "It does not stop prompt injection. A 2026 formal result\nargues perfect prevention is unachievable at the model\nlayer, and adaptive attacks beat deployed commercial\ndetectors well above 90% while those detectors report\nnear zero under static evaluation. What this model does\nis shrink the reach of a compromised session.",
      "originalText": "It does not stop prompt injection. A 2026 formal result\nargues perfect prevention is unachievable at the model\nlayer, and adaptive attacks beat deployed commercial\ndetectors well above 90% while those detectors report\nnear zero under static evaluation. What this model does\nis shrink the reach of a compromised session.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "rectangle_gt",
      "type": "rectangle",
      "x": 40,
      "y": 790,
      "width": 1400,
      "height": 127,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 612609590,
      "version": 1,
      "versionNonce": 427699700,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text_gu",
      "type": "text",
      "x": 52,
      "y": 802,
      "width": 262,
      "height": 21,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1731920089,
      "version": 1,
      "versionNonce": 2123722056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The one-line test for this document",
      "originalText": "The one-line test for this document",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    },
    {
      "id": "text_gv",
      "type": "text",
      "x": 52,
      "y": 829,
      "width": 1376,
      "height": 76,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1907991984,
      "version": 1,
      "versionNonce": 1549890775,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pick any action in the ledger. You must be able to name the human, the agent version and its composition digest, the instance\nand the machine it ran on, the session and whether it was tainted, the task and where it came from, the grant that permitted it,\nthe credential lease it used, the policy version that decided it, and the enforcement grade of that decision. If any of those is\nmissing, the ledger is telemetry rather than evidence, and it will not survive an investigation.",
      "originalText": "Pick any action in the ledger. You must be able to name the human, the agent version and its composition digest, the instance\nand the machine it ran on, the session and whether it was tainted, the task and where it came from, the grant that permitted it,\nthe credential lease it used, the policy version that decided it, and the enforcement grade of that decision. If any of those is\nmissing, the ledger is telemetry rather than evidence, and it will not survive an investigation.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.45,
      "autoResize": true
    }
  ],
  "appState": {
    "gridSize": null,
    "viewBackgroundColor": "#ffffff"
  },
  "files": {}
}
