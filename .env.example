# Copy to .env. `make bootstrap` does this for you.
#
# Every deployment difference between our cloud, a customer's cloud and an air-gapped
# install is expressed here. The application refuses to start on an invalid combination
# — see the validators in app/config.py.

# ---------------------------------------------------------------- deployment shape
# saas   we operate it, multi-tenant
# byoc   customer's cloud, we manage, single-tenant, opt-in telemetry
# airgap customer operates it, no egress whatsoever
AAP_DEPLOYMENT_MODE=saas
AAP_TENANCY=multi
AAP_INSTANCE_NAME=local
AAP_ENVIRONMENT=development
AAP_DEFAULT_ORG_SLUG=default

# ---------------------------------------------------------------- database
# Points at managed Postgres in any real deployment: RDS, Azure Database, Cloud SQL.
POSTGRES_PASSWORD=devonly
DATABASE_URL=postgresql+psycopg://aap:devonly@postgres:5432/aap
AAP_DB_POOL_SIZE=10
AAP_DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------- object store
# local | s3 | azblob | gcs
AAP_OBJECT_STORE=local
AAP_OBJECT_STORE_LOCAL_PATH=/var/lib/aap/artifacts
# AAP_OBJECT_STORE_BUCKET=acme-aap-artifacts
# AAP_OBJECT_STORE_PREFIX=assurance/
# AAP_OBJECT_STORE_ENDPOINT=http://minio:9000

# ---------------------------------------------------------------- secrets
# env | aws_sm | az_kv | gcp_sm | vault
AAP_SECRETS_PROVIDER=env
AAP_SECRETS_PREFIX=aap/
# AAP_AZURE_VAULT_URL=https://acme-kv.vault.azure.net/
# AAP_GCP_PROJECT=acme-prod
# VAULT_ADDR=https://vault.acme.internal

# ---------------------------------------------------------------- signing
# local | aws_kms | az_kv | gcp_kms
#
# In BYOC, point this at the customer's own KMS. It makes us structurally incapable of
# signing on their behalf, which is a far stronger guarantee than a promise not to.
AAP_SIGNING_PROVIDER=local
AAP_SIGNING_KEY_PATH=/run/secrets/signing.pem
# AAP_SIGNING_KEY_REF=arn:aws:kms:eu-west-1:111122223333:key/abc-123
# AAP_CLOUD_REGION=eu-west-1

# ---------------------------------------------------------------- licensing
# Required for byoc and airgap. Validated offline, always.
# AAP_LICENSE_FILE=/etc/aap/license.aap
# AAP_LICENSE_PUBLIC_KEY_PATH=/etc/aap/license-pub.pem

# ---------------------------------------------------------------- identity
# Generic OIDC. Entra, Okta, Keycloak and Auth0 are all just an issuer here.
#
#   Entra      https://login.microsoftonline.com/<tenant>/v2.0
#   Okta       https://<org>.okta.com/oauth2/default
#   Auth0      https://<tenant>.eu.auth0.com/
#   Keycloak   https://kc.example.com/realms/<realm>
#
# Setting an issuer makes the audience mandatory: without it, any token that issuer
# signed for any other application is accepted here.
# AAP_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# AAP_OIDC_AUDIENCE=agent-assurance
#
# Which claims may carry the tenant, tried in order. The value found is looked up in
# `identity_bindings`; nothing resolves until a binding exists for it.
#   org_id  an IdP we own that mints the claim   tid  Entra tenant id
#   hd      Google Workspace domain              iss  a dedicated IdP per customer
# AAP_OIDC_ORG_CLAIMS=org_id,tid,hd,iss
#
# Asymmetric only. Listing an HMAC algorithm turns the public verification key into a
# signing secret, and the config validator refuses it.
# AAP_OIDC_ALGORITHMS=RS256,RS384,RS512,ES256,ES384,ES512
# AAP_OIDC_JWKS_CACHE_SECONDS=3600
# AAP_OIDC_JWKS_URL=          # only for an issuer with no discovery document

# Reads the organisation from an X-Org-Id header instead of a token. Development only —
# Settings refuses to construct with this set unless AAP_ENVIRONMENT=development.
AAP_DEV_AUTH_BYPASS=true

# ---------------------------------------------------------------- egress
# Must both be false in airgap mode; the config validator enforces it.
AAP_TELEMETRY_ENABLED=false
AAP_UPDATE_CHECK_ENABLED=false

# ---------------------------------------------------------------- evidence
AAP_EVIDENCE_RETENTION_DAYS=400
AAP_EVIDENCE_MAX_TEXT_BYTES=512

# ---------------------------------------------------------------- assurance
AAP_MATERIALITY_RULESET=default
AAP_PROMPT_DRIFT_MATERIAL_THRESHOLD=0.15
AAP_PROMPT_DRIFT_REVIEW_THRESHOLD=0.05

# ---------------------------------------------------------------- runtime
AAP_WORKER_CONCURRENCY=4
AAP_LOG_LEVEL=INFO
AAP_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- collector
COLLECTOR_KEY=devkey
# Created once by the local runtime bootstrap after migrations/seed complete. The same
# scoped credential lets the collector ingest traces and Evaluate call Prompt/Router.
# RUNTIME_ORG_ID=
# RUNTIME_PROJECT_ID=
# RUNTIME_WORKLOAD_BEARER=
# OTLP/HTTP. 4318 is the standard port and the default; override it if the host has it
# reserved. Windows reserves shifting blocks for Hyper-V, and a block covering 4318
# makes the container fail to start with a bind error and nothing holding the port.
# OTLP_PORT=4318

# ---------------------------------------------------------------- observe payloads
# Required for redacted/full capture. Generate a unique Fernet key for each environment
# and inject it from a secret manager; never commit a production key.
# OBSERVE_PAYLOAD_ENCRYPTION_KEY=

# ---------------------------------------------------------------- host ports
# Only relevant when something else on the machine already has one.
# POSTGRES_PORT=5432
